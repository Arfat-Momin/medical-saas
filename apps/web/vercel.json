{
    "buildCommand": "pnpm --filter @medical/web build",
    "installCommand": "pnpm install --frozen-lockfile",
    "outputDirectory": "apps/web/dist",
    "framework": null,
    "rewrites": [
        {
            "source": "/((?!api|assets|icons|favicon|manifest|sw\\.js|registerSW\\.js|workbox-).*)",
            "destination": "/index.html"
        }
    ]
}