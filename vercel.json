{
    "framework": "vite",
    "installCommand": "corepack enable && pnpm install --frozen-lockfile",
    "buildCommand": "pnpm --filter @medical/web build",
    "outputDirectory": "apps/web/dist",
    "rewrites": [
        {
            "source": "/((?!assets/|icons/|favicon\\.png|manifest\\.webmanifest|registerSW\\.js|sw\\.js|workbox-.*).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/registerSW.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ]
}